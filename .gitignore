# Artifact / data dirs are anchored to the repo root (leading /) so that code
# dirs like scripts/figures/ are NOT ignored.
/workdir/
# raw archives (symlink) + processed tensors
/data/
# surrogate checkpoints
/models/
# per-run RL outputs
/runs/
# cross-run aggregates
/results/
# final plots / animations
/figures/
/lightning_logs/
dump*.yaml
__pycache__/
*.egg-info/
.venv/
*.pyc
.pytest_cache/
